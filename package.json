{
  "name": "expo-gradle-jvmargs",
  "version": "1.2.0",
  "description": "Expo config plugin to manage Gradle daemon JVM args (org.gradle.jvmargs) and optional kotlin.daemon.jvmargs.",
  "main": "app.plugin.js",
  "types": "plugin/build/withGradleJvmArgs.d.ts",
  "exports": {
    ".": {
      "types": "./plugin/build/withGradleJvmArgs.d.ts",
      "default": "./app.plugin.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.app.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-gradle-jvmargs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hebertcisco/expo-gradle-jvmargs.git"
  },
  "bugs": {
    "url": "https://github.com/hebertcisco/expo-gradle-jvmargs/issues"
  },
  "author": "hebertcisco",
  "license": "MIT",
  "homepage": "https://github.com/hebertcisco/expo-gradle-jvmargs",
  "files": [
    "app.plugin.js",
    "plugin/build",
    "README.md",
    "CHANGELOG.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9",
    "@expo/config-plugins": "^57",
    "@types/jest": "^29",
    "@types/node": "^20",
    "eslint": "^9",
    "jest": "^29",
    "jiti": "^2.7.0",
    "ts-jest": "^29",
    "ts-node": "^10",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "js-yaml": ">=5.4.2",
    "glob/minimatch": "10.2.6"
  },
  "overrides": {
    "js-yaml": ">=5.4.2",
    "glob": {
      "minimatch": "10.2.6"
    }
  }
}
